# Strow Ops — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.

# ─── Supabase ─────────────────────────────────────────────
# Get these from Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (receipt extraction) ───────────────────────
# Generate at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── Google Drive (photo storage) ─────────────────────────
# Created in Google Cloud Console → APIs & Services → Credentials
# Type: OAuth 2.0 Client ID, "Web application"
# Refresh token obtained via one-time OAuth flow (instructions in /docs)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Folder ID for the /Strow/ root folder in your Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─── Auth (PIN sessions) ──────────────────────────────────
# Random 32-byte secret for signing barista session tokens
# Generate with: openssl rand -base64 32
SESSION_JWT_SECRET=

# ─── Whapi (Phase 2 — staff WhatsApp notifications) ───────
# Required only when Phase 2 ships. Leave blank for v1.
WHAPI_TOKEN=
WHAPI_CHANNEL_ID=
WHAPI_NOTIFICATION_GROUP_ID=
