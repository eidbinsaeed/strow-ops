# Strow Ops - environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.

# --- Supabase ----------------------------------------------------
# Get these from Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (receipt extraction) ------------------------------
# Generate at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Google Drive (photo storage) --------------------------------
# Created in Google Cloud Console -> APIs & Services -> Credentials
# Type: OAuth 2.0 Client ID, "Web application"
# Run scripts/get-drive-refresh-token.mjs once to obtain GOOGLE_DRIVE_REFRESH_TOKEN.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Folder ID for the /Strow/ root folder in your Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Sessions (barista + owner JWT cookies) ----------------------
# Random 32-byte secret for signing session tokens
# Generate with: openssl rand -base64 32
SESSION_JWT_SECRET=

# --- Owner PIN -----------------------------------------------------
# 4-8 digit PIN that unlocks /owner/**.
# Set this to a hard-to-guess string and rotate periodically.
OWNER_PIN=

# --- Whapi (Phase 2 - staff WhatsApp notifications) -------------
# Required only when Phase 2 ships. Leave blank for v1.
WHAPI_TOKEN=
WHAPI_CHANNEL_ID=
WHAPI_NOTIFICATION_GROUP_ID=
